{
  "name": "academic-platform-dev-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Herramientas locales de administración/staging para el proyecto de Firestore. No forman parte del sitio publicado.",
  "scripts": {
    "inspect": "node inspect-firestore.js",
    "rules:test": "cd .. && ./scripts/node_modules/.bin/firebase emulators:exec --only firestore \"node scripts/rules-test.js\"",
    "smoke:local": "node smoke-test.js",
    "admin-console": "node admin-console/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^15.24.0",
    "playwright": "^1.62.0"
  }
}
