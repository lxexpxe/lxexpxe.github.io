rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // No hay campo "role" separado en la app. professors/{uid} en sí casi
    // siempre es un doc "fantasma" (solo contenedor de subcolecciones, sin
    // datos propios) — pero profile/data SIEMPRE se escribe en el registro,
    // así que es la fuente de verdad confiable de "¿es profesor?".
    function isProfessor() {
      return exists(/databases/$(database)/documents/artifacts/academic-platform/professors/$(request.auth.uid)/profile/data);
    }

    function ownsCourse(profId, courseId) {
      return exists(/databases/$(database)/documents/artifacts/academic-platform/professors/$(profId)/courses/$(courseId));
    }

    // --- Juego "Expedición" (teams/progress/announcements) ---

    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/artifacts/academic-platform/teams/$(teamId)) &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/academic-platform/teams/$(teamId)).data.memberUids;
    }

    // progress/{teamId} es UN documento por equipo con una clave por semana
    // ('1' a '12'), no una subcolección — así que "solo status/note, nunca
    // crystals ni status:'done'" hay que validarlo dentro de cada clave de
    // semana que cambió. Rules no tiene loops ni forma de sacar un elemento
    // de un Set sin conocer la clave de antemano, así que se revisan las 12
    // semanas una por una a mano; cada llamada es gratis si esa semana en
    // particular no cambió.
    function oldProgressData() {
      return resource != null ? resource.data : {};
    }

    function weekEditOk(wk) {
      return !(wk in request.resource.data.diff(oldProgressData()).affectedKeys()) || (
        request.resource.data.get(wk, {}).get('crystals', 0) == oldProgressData().get(wk, {}).get('crystals', 0) &&
        request.resource.data.get(wk, {}).get('status', '') != 'done'
      );
    }

    function studentProgressEditOk() {
      return weekEditOk('1') && weekEditOk('2') && weekEditOk('3') && weekEditOk('4') &&
        weekEditOk('5') && weekEditOk('6') && weekEditOk('7') && weekEditOk('8') &&
        weekEditOk('9') && weekEditOk('10') && weekEditOk('11') && weekEditOk('12');
    }

    // Regla aparte para collectionGroup('courses'): las reglas anidadas de
    // más abajo (dentro de /artifacts/academic-platform/...) solo cubren
    // lecturas por ruta directa/subcolección — una consulta collectionGroup
    // necesita su propia regla con wildcard recursivo para autorizarse,
    // aunque el permiso real (mismo: cualquier autenticado) sea idéntico.
    // Esto es lo que permite buscar un curso por código sin depender de que
    // el doc professors/{uid} "exista" (la mayoría son fantasma).
    match /{path=**}/courses/{courseId} {
      allow read: if signedIn();
    }

    match /artifacts/academic-platform {

      match /professors/{profId} {
        // Lectura amplia: el flujo de "unirse a curso por código" recorre todos
        // los profesores para encontrar el curso. Nada sensible vive en este doc
        // (el perfil real está en profile/data, restringido abajo).
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == profId;

        match /profile/data {
          allow read, write: if signedIn() && request.auth.uid == profId;
        }

        match /courses/{courseId} {
          // Necesario para: búsqueda por código de curso, y estudiantes
          // matriculados viendo contenido semanal / badges disponibles.
          allow read: if signedIn();
          allow write: if signedIn() && request.auth.uid == profId;

          match /students/{studentId} {
            // El profesor ve/gestiona todo su roster; cada estudiante solo su
            // propio registro (nunca lo escribe directamente: badges/aprobación
            // los maneja el profesor).
            allow read: if signedIn() && (request.auth.uid == profId || request.auth.uid == studentId);
            allow write: if signedIn() && request.auth.uid == profId;

            // Excepción puntual: el estudiante puede corregir su propio
            // fullName (se copia como snapshot al aprobar en cada curso, así
            // que un cambio de perfil debe poder propagarse a todos). Solo se
            // permite si fullName es el ÚNICO campo que cambia — badges,
            // approvedAt, etc. siguen bloqueados para el estudiante.
            allow update: if signedIn() && request.auth.uid == studentId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']);
          }
        }
      }

      match /courses/{courseId} {
        // Catálogo global: hoy solo se escribe, nada lo lee (ver README). Se
        // deja lectura abierta por si se usa a futuro; lo que importa es que
        // solo el profesor dueño del curso pueda crear/modificar/borrar.
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.professorId == request.auth.uid;
        allow update, delete: if signedIn() && (
          resource.data.professorId == request.auth.uid ||
          ownsCourse(request.auth.uid, courseId)
        );

        match /attendance/{date} {
          allow read: if signedIn() && (
            resource == null ||
            ownsCourse(request.auth.uid, courseId) ||
            exists(/databases/$(database)/documents/artifacts/academic-platform/professors/$(resource.data.professorId)/courses/$(courseId)/students/$(request.auth.uid))
          );

          // Crear: el profesor dueño (marcado manual), o un estudiante
          // matriculado registrando su propio primer check-in del día.
          allow create: if signedIn() && (
            ownsCourse(request.auth.uid, courseId) ||
            (
              request.resource.data.professorId is string &&
              exists(/databases/$(database)/documents/artifacts/academic-platform/professors/$(request.resource.data.professorId)/courses/$(courseId)/students/$(request.auth.uid))
            )
          );

          // Actualizar: el profesor dueño puede reescribir libremente su propio
          // registro de asistencia. Un estudiante matriculado solo puede
          // *agregarse a sí mismo* al final del arreglo students — no puede
          // tocar ni borrar los registros de otros.
          // El chequeo de "prefijo sin cambios" (students[0:N] == students viejo)
          // se salta cuando el arreglo viejo está vacío: el motor de reglas de
          // Firestore no soporta slices vacíos (students[0:0]) — revienta con un
          // error interno de índice fuera de rango en vez de devolver [], que es
          // justo el caso real de un doc creado por el botón "Crear día de hoy"
          // (students: []) antes de que nadie escanee.
          allow update: if signedIn() && (
            ownsCourse(request.auth.uid, courseId) ||
            (
              exists(/databases/$(database)/documents/artifacts/academic-platform/professors/$(resource.data.professorId)/courses/$(courseId)/students/$(request.auth.uid)) &&
              request.resource.data.professorId == resource.data.professorId &&
              request.resource.data.students.size() == resource.data.students.size() + 1 &&
              (
                resource.data.students.size() == 0 ||
                request.resource.data.students[0:resource.data.students.size()] == resource.data.students
              ) &&
              request.resource.data.students[resource.data.students.size()].studentId == request.auth.uid
            )
          );

          // Solo el profesor dueño puede borrar un doc de asistencia — lo usa
          // "Nuevo Semestre" al moverlo a attendance-archive.
          allow delete: if signedIn() && ownsCourse(request.auth.uid, courseId);
        }

        match /attendance-archive/{date} {
          // Historial archivado por "Nuevo Semestre": nadie más que el
          // profesor dueño necesita verlo o tocarlo.
          allow read, write: if signedIn() && ownsCourse(request.auth.uid, courseId);
        }

        match /enrollments/{studentId} {
          // Nada lo lee hoy tampoco; se deja lectura abierta y escritura
          // restringida al profesor dueño (así se crea/borra en approveStudent).
          allow read: if signedIn();
          allow write: if signedIn() && ownsCourse(request.auth.uid, courseId);
        }
      }

      match /temp-students/{studentId} {
        // El estudiante gestiona su propia solicitud pendiente; cualquier
        // profesor puede listarlas (para encontrar solicitudes de su curso) y
        // borrarlas al aprobar/rechazar. Un estudiante NO puede leer las
        // solicitudes de otros.
        allow create, update: if signedIn() && request.auth.uid == studentId;
        allow read: if signedIn() && (request.auth.uid == studentId || isProfessor());
        allow delete: if signedIn() && isProfessor();
      }

      match /teams/{teamId} {
        // Lectura abierta: cualquier estudiante autenticado necesita ver
        // todos los equipos para poder elegir el suyo. Solo un profesor
        // crea/edita/borra equipos — los estudiantes no se auto-asignan.
        allow read: if signedIn();
        allow write: if signedIn() && isProfessor();
      }

      match /progress/{teamId} {
        // Lectura abierta (equipos ven su propio avance, y el de otros para
        // el tablero de posiciones). Escritura:
        //  - Cualquier profesor puede escribir libremente — incluye asignar
        //    crystals y marcar status:'done' al calificar.
        //  - Un miembro del equipo puede enviar/actualizar su propio avance
        //    (status, note, submittedAt), pero nunca puede tocar crystals ni
        //    ponerse a sí mismo status:'done' — eso es la calificación.
        allow read: if signedIn();
        allow write: if signedIn() && (
          isProfessor() ||
          (isTeamMember(teamId) && studentProgressEditOk())
        );
      }

      match /announcements/{annId} {
        // Lectura abierta a cualquier autenticado; solo un profesor publica
        // transmisiones de la expedición.
        allow read: if signedIn();
        allow write: if signedIn() && isProfessor();
      }
    }
  }
}
